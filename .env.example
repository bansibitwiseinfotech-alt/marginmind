# MarginMind Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

PORT=5000
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# MongoDB Application Database (Atlas or local)
MONGODB_URI=

# Shared Secret for Internal Server-to-Server API Calls (Shopify route -> Express backend)
# Generate a strong random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
INTERNAL_API_SECRET=

# Shopify App Credentials (from Shopify Partners Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify Scopes required for MarginMind (Products, Orders, Customers, Inventory, Discounts)
SCOPES=read_products,write_products,read_orders,read_customers,read_discounts,read_inventory,read_locations,write_metaobjects,write_metaobject_definitions

# Shopify App URL (dynamically set by shopify app dev tunnel or production host)
# SHOPIFY_APP_URL=https://your-app-tunnel.com
